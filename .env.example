DATABASE_URL="postgres://conduzx:conduzx@localhost:5432/conduzx"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Conta global: configurar uma vez com npm run db:super-admin
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Super-Admin"

# Pasta dos documentos carregados (fora de public/). Usada enquanto o R2 não estiver configurado.
STORAGE_DIR="./storage"

# Cloudflare R2 (privado): preencher os quatro para guardar os documentos no R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Só para buckets com jurisdição, ex.: https://<conta>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=""
